{
  "manifest_version": 3,
  "name": "Hide Profile",
  "version": "1.1.0",
  "description": "Blur, hide or replace profile pictures on social platforms. Optional swear-word masking and media blur.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Toggle Hide Profile on/off"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.linkedin.com/*",
        "*://*.peerlist.io/*",
        "*://*.github.com/*",
        "*://*.reddit.com/*",
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.threads.net/*",
        "*://*.threads.com/*",
        "*://*.facebook.com/*",
        "*://*.bsky.app/*",
        "*://*.dev.to/*",
        "*://*.medium.com/*"
      ],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
